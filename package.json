{
  "name": "aggroso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"tsx server/server.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "tsx server/server.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx src/utils/testRunner.ts",
    "test:backend": "tsx server/testBackend.ts",
    "test:all": "tsx src/utils/testRunner.ts && tsx server/testBackend.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "nodemon": "^3.1.14",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}

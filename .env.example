GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001

# --- RAILWAY (backend) ---
# Set this to your Vercel frontend URL after deploying frontend (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# --- VERCEL (frontend) ---
# Set this to your Railway backend URL after deploying backend
VITE_API_URL=https://your-app.railway.app

# Dev only (used by Vite proxy, same key as GEMINI_API_KEY)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
